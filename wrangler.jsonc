{
  "$schema": "node_modules/wrangler/config-schema.json",

  "name": "family-audio-vault",

  "main": ".open-next/worker.js",

  "compatibility_date": "2026-08-08",

  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],

  "secrets": {
  "required": [
    "OPENAI_API_KEY",
    "R2_ACCESS_KEY_ID",
    "R2_SECRET_ACCESS_KEY"
  ]
}

"assets": {
  "directory": ".open-next/assets",
  "binding": "ASSETS",
  "run_worker_first": false
},

  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "family-audio-vault"
    }
  ],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "family-audio-vault-db",
      "database_id": "9cb26246-1748-442f-9cea-76fef0663b0e",
      "migrations_dir": "cloudflare/migrations"
    }
  ],

  "r2_buckets": [
    {
      "binding": "VAULT_FILES",
      "bucket_name": "family-audio-vault-files"
    }
  ]
}
